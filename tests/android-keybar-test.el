(ert-deftest android-keybar-starting-with-keyboard-open-can-detect-first-close ()
  (android-keybar-test-with-state
    (android-keybar-test-with-geometry
      ;; No closed-height sample exists yet; monitor height includes 135px
      ;; of system bars and cannot be used with the tighter closing threshold.
      (setq height 1253)
      (my/android-keybar-sync-visibility)
      (should my/android-keybar-keyboard-visible)
      (setq height 2205)
      (my/android-keybar-sync-visibility)
      (should-not my/android-keybar-keyboard-visible)
      (should my/android-keybar-hidden))))

(ert-deftest android-keybar-install-preserves-input-and-modifier-state ()
  (android-keybar-test-with-state
    (setq my/android-keybar-armed-modifiers '(shift)
          my/android-keybar-locked-modifiers '(control meta)
          my/android-keybar-movement-active t
          my/android-keybar-keyboard-visible t
          my/android-keybar-saved-translation '(t . preserved)
          my/android-keybar-saved-conversion-override '(t . preserved))
    (define-key key-translation-map [t] #'my/android-keybar-translate-locked)
    (my/android-keybar-install)
    (should (equal my/android-keybar-armed-modifiers '(shift)))
    (should (equal my/android-keybar-locked-modifiers '(control meta)))
    (should my/android-keybar-movement-active)
    (should (equal my/android-keybar-saved-translation '(t . preserved)))
    (should (equal my/android-keybar-saved-conversion-override '(t . preserved)))
    (should (eq (lookup-key key-translation-map [t])
                #'my/android-keybar-translate-locked))
    (cl-letf (((symbol-function 'my/android-keybar-flash-button) #'ignore))
      (should (equal (funcall (lookup-key input-decode-map [tool-bar escape]) nil)
                     [escape]))
      (should (equal (funcall (lookup-key input-decode-map [tool-bar tab]) nil)
                     [9])))
    (should (eq (my/android-keybar-apply-modifiers 9 '(shift)) 'backtab))
    (should (eq (lookup-key input-decode-map [tool-bar movement])
                #'my/android-keybar-movement-decoder))
    (should (eq (lookup-key input-decode-map [tool-bar collapse])
                #'my/android-keybar-hide-decoder))))

(ert-deftest android-keybar-hidden-install-does-not-reset-manual-latch ()
  (android-keybar-test-with-state
    (setq my/android-keybar-manually-hidden t
          my/android-keybar-keyboard-visible t)
    (my/android-keybar-install)
    (should my/android-keybar-manually-hidden)
    (should my/android-keybar-hidden)
    (should-not modifier-bar-mode)
    (should-not tool-bar-mode)))

(ert-deftest android-keybar-visibility-mutation-is-deferred-and-coalesced ()
  (android-keybar-test-with-state
    (let ((my/android-keybar-visibility-timer 'old-timer)
          canceled queued)
      (cl-letf (((symbol-function 'timerp)
                 (lambda (object) (memq object '(old-timer next-timer))))
                ((symbol-function 'cancel-timer)
                 (lambda (timer) (push timer canceled)))
                ((symbol-function 'run-at-time)
                 (lambda (delay repeat function &rest args)
                   (should (zerop delay))
                   (should-not repeat)
                   (push (cons function args) queued)
                   'next-timer))
                ((symbol-function 'my/android-keybar-sync-visibility)
                 (lambda (&rest _) (ert-fail "Visibility changed inside size hook"))))
        (my/android-keybar-schedule-visibility)
        (my/android-keybar-schedule-visibility)
        (should (equal (nreverse canceled) '(old-timer next-timer)))
        (should (= (length queued) 2))
        (should (eq my/android-keybar-visibility-timer 'next-timer))))))

(ert-deftest android-keybar-return-exits-movement-without-releasing-other-locks ()
  (android-keybar-test-with-state
    (cl-letf (((symbol-function 'my/android-keybar-sync-lock) #'ignore))
      (dolist (event '(return linefeed newline 10 13))
        (setq my/android-keybar-locked-modifiers '(control meta)
              my/android-keybar-movement-active t)
        (should (= 13 (my/android-keybar-apply-modifiers event '(control meta))))
        (should-not my/android-keybar-movement-active)
        (should (equal my/android-keybar-locked-modifiers '(meta)))))))

(ert-run-tests-batch-and-exit "^android-keybar-")
