               (lambda () '("test bookmark"))))
      (with-temp-buffer
        (my/android-dashboard-bookmarks)
        (should (equal (buffer-substring-no-properties (point-min) (+ (point-min) 3))
                       "\n\n\n"))
        (should-not (get-text-property (point-min) 'line-height))
        (should (button-at (+ (point-min) 3)))))))

(defun android-dashboard-test-upstream-resize (&rest _)
  "Reproduce Doom's affected point-restoration branch without loading Doom.
These are the relevant forms of `+dashboard-resize-h': the window loop is
outside its later `with-current-buffer' body.  Keep this fixture unguarded
so the regression demonstrates the failure before applying our advice."
  (when-let* ((windows (get-buffer-window-list (get-buffer +dashboard-name) nil t)))
    (dolist (w windows)
      (when-let* ((pos (window-parameter w '+dashboard-last-position)))
        (goto-char pos)
        ;; The relevant non-region branch of +dashboard-reposition-point-h.
        (when (eq (current-buffer) (get-buffer +dashboard-name))
          (unless (button-at (point))
            (forward-button 1 nil nil t)))))))

(ert-deftest android-dashboard-resize-restores-only-dashboard-point ()
  (let ((dashboard (generate-new-buffer " *dashboard-resize-test*"))
        (editing (generate-new-buffer " *dashboard-edit-test*")))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (switch-to-buffer editing)
          (insert (make-string 1000 ?x))
          (with-current-buffer dashboard
            (insert "\n\n\n")
            (insert-text-button "bookmark")
            (insert "\n"))
          (let* ((+dashboard-name (buffer-name dashboard))
                 (editing-window (selected-window))
                 (dashboard-window (split-window-below)))
            (set-window-buffer dashboard-window dashboard)
            (set-window-parameter dashboard-window '+dashboard-last-position 1)
            ;; Prove the exact upstream ordering clobbers the unrelated point.
            (goto-char 900)
            (android-dashboard-test-upstream-resize)
            (should (= (point) 1))
            ;; The fixed call retains editing point, window and current buffer,
            ;; while the dashboard's normal button-restoration logic still runs.
            (goto-char 900)
            (my/android-dashboard-resize-in-buffer
             #'android-dashboard-test-upstream-resize)
            (should (= (point) 900))
            (should (eq (current-buffer) editing))
            (should (eq (selected-window) editing-window))
            (with-current-buffer dashboard
              (should (= (point) 4))
              (should (button-at (point))))))
      (kill-buffer dashboard)
      (kill-buffer editing))))

(ert-deftest android-dashboard-resize-without-dashboard-passes-through ()
  (let ((+dashboard-name " *absent-dashboard-for-resize-test*"))
    (with-temp-buffer
      (insert "editing")
      (goto-char 4)
      (let ((original-buffer (current-buffer)))
        (should
         (eq (my/android-dashboard-resize-in-buffer
              (lambda (arg)
                (should (eq (current-buffer) original-buffer))
                (should (= (point) 4))
                arg)
              'unchanged)
             'unchanged))
        (should (= (point) 4))))))

(ert-deftest android-dashboard-resize-error-restores-calling-buffer ()
  (let ((dashboard (generate-new-buffer " *dashboard-resize-error-test*")))
    (unwind-protect
        (let ((+dashboard-name (buffer-name dashboard)))
          (with-temp-buffer
            (insert "editing")
            (goto-char 4)
            (let ((original-buffer (current-buffer)))
              (should-error
               (my/android-dashboard-resize-in-buffer
                (lambda ()
                  (should (eq (current-buffer) dashboard))
                  (error "Test resize error"))))
              (should (eq (current-buffer) original-buffer))
              (should (= (point) 4)))))
      (kill-buffer dashboard))))

(ert-deftest android-dashboard-centers-measured-content-not-fixed-line-count ()
  (let ((buffer (get-buffer-create "*doom*")))
    (unwind-protect
        (with-current-buffer buffer
          (erase-buffer)
          (insert (propertize " " 'my/android-dashboard-spacer t)
                  "\nD O O M\nE M A C S\nbookmark\n")
          (cl-letf (((symbol-function 'get-buffer-window) (lambda (&rest _) 'test-window))
                    ((symbol-function 'window-text-pixel-size)
                     (lambda (_window from to &rest _)
                       (if (= from 1)
                           (progn (should (= to 3)) '(1 . 20))
                         (progn (should (= from 3)) '(200 . 400)))))
                    ((symbol-function 'window-body-height) (lambda (&rest _) 1000)))
            (my/android-dashboard-center-wordmark)
            ;; 300px = 15 plain lines: one permanent anchor plus 14 newlines.
            (should (= (next-single-property-change
                        3 'my/android-dashboard-padding nil (point-max)) 17))
            (should (= (line-number-at-pos 17) 16))
            (should-not (text-property-not-all (point-min) (point-max) 'display nil))
            (should-not (text-property-not-all (point-min) 17 'line-height nil))))
      (kill-buffer buffer))))

(ert-deftest android-dashboard-short-window-clamps-padding ()
  (let ((buffer (get-buffer-create "*doom*")))
    (unwind-protect
        (with-current-buffer buffer
          (erase-buffer)
          (insert (propertize " " 'my/android-dashboard-spacer t) "\nbody\n")
          (cl-letf (((symbol-function 'get-buffer-window) (lambda (&rest _) 'test-window))
                    ((symbol-function 'window-text-pixel-size)
                     (lambda (_window from &rest _)
                       (if (= from 1) '(1 . 20) '(200 . 400))))
                    ((symbol-function 'window-body-height) (lambda (&rest _) 200)))
            (my/android-dashboard-center-wordmark)
            (should (equal (buffer-substring-no-properties (point-min) (point-max))
                           " \nbody\n"))
            (should-not (get-text-property (point-min) 'display))))
      (kill-buffer buffer))))

(ert-deftest android-dashboard-padding-recalculates-without-moving-content-point ()
  (let ((buffer (get-buffer-create "*doom*"))
        (height 1000)
        (line-height 20))
    (unwind-protect
        (with-current-buffer buffer
          (erase-buffer)
          ;; Include the obsolete stretched glyph to exercise hot migration.
          (insert (propertize " " 'my/android-dashboard-spacer t
                              'display '(space :width (0) :height (758)))
                  "\nbody\n")
          (goto-char 3)
          (cl-letf (((symbol-function 'get-buffer-window) (lambda (&rest _) 'test-window))
                    ((symbol-function 'window-text-pixel-size)
                     (lambda (_window from &rest _)
                       (if (= from 1) (cons 1 line-height) '(200 . 400))))
                    ((symbol-function 'window-body-height) (lambda (&rest _) height)))
            (my/android-dashboard-center-wordmark)
            (should (= (point) 17))
            (should (eq (char-after) ?b))
            (let ((text (buffer-string)))
              (my/android-dashboard-center-wordmark)
              (should (equal (buffer-string) text)))
            ;; A taller remapped font needs fewer plain lines for the same gap.
            (setq line-height 30)
            (my/android-dashboard-center-wordmark)
            (should (= (point) 12))
            (should (eq (char-after) ?b))
            ;; Closing the available height removes only our padding.
            (setq height 400)
            (my/android-dashboard-center-wordmark)
            (should (= (point) 3))
            (should (eq (char-after) ?b))
            (should (equal (buffer-substring-no-properties (point-min) (point-max))
                           " \nbody\n"))
            (should-not (get-text-property (point-min) 'display))))
      (kill-buffer buffer))))

