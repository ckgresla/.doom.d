        (should (= text-scale-mode-amount -1))))))

(ert-deftest android-dashboard-render-rehides-modeline-after-doom-overrides-it ()
  (let ((bookmark-alist nil)
        (global-format (default-value 'mode-line-format))
        (calls 0)
        (original-require (symbol-function 'require)))
    (cl-letf (((symbol-function 'bookmark-maybe-load-default-file) #'ignore)
              ((symbol-function 'require)
               (lambda (feature &rest args)
                 (if (eq feature 'hide-mode-line) t
                   (apply original-require feature args))))
              ((symbol-function 'hide-mode-line-mode)
               (lambda (arg)
                 (should (= arg 1))
                 (cl-incf calls)
                 (setq-local hide-mode-line-mode t mode-line-format nil))))
      (with-temp-buffer
        ;; Existing dashboards need this even when their minor-mode flag is t.
        (setq-local hide-mode-line-mode t mode-line-format '(dashboard-format))
        (my/android-dashboard-wordmark)
        (should-not mode-line-format)
        (setq-local mode-line-format '(dashboard-format))
        (erase-buffer)
        (my/android-dashboard-wordmark)
        (should-not mode-line-format)
        (should (= calls 2)))
      (should (equal (default-value 'mode-line-format) global-format)))))

(ert-deftest android-dashboard-buttons-retain-full-name-and-action ()
  (let ((name "a long bookmark name containing 日本語\nand a newline")
        activated)
    (with-temp-buffer
      (insert (my/android-dashboard-bookmark-button name 20))
      (should (= (string-width (buffer-string)) 20))
      (should-not (string-match-p "[\n\r\t]" (buffer-string)))
      (let ((button (button-at (point-min))))
        (should (button-get button 'follow-link))
        (should (eq (button-get button 'mouse-face) 'highlight))
        (should (eq (plist-get (button-get button 'face) :inherit) 'default))
        (cl-letf (((symbol-function 'bookmark-jump)
                   (lambda (target) (setq activated target))))
          (button-activate button)
          (should (equal activated name)))))))

(ert-deftest android-dashboard-buttons-use-current-theme-background ()
  (cl-letf (((symbol-function 'my/android-dashboard-block-background)
             (lambda () "#eeeeee"))
            ((symbol-function 'face-foreground) (lambda (&rest _) "#222222")))
    (with-temp-buffer
      (insert (my/android-dashboard-bookmark-button "life" 20))
      (let ((face (button-get (button-at (point-min)) 'face)))
        (should (equal (plist-get face :background) "#eeeeee"))
        (should (equal (plist-get face :foreground) "#222222"))
        (should-not (plist-member face :family))
        (should-not (plist-member face :height))))))

(ert-deftest android-dashboard-button-map-isolated-and-explicit ()
  (should-not (eq my/android-dashboard-button-map button-map))
  (should (eq (lookup-key my/android-dashboard-button-map [down-mouse-1]) #'ignore))
  (dolist (event '([mouse-1] [mouse-2] [touchscreen-down]))
    (should (eq (lookup-key my/android-dashboard-button-map event)
                #'my/android-dashboard-push-button)))
  ;; Do not replace the standard button bindings in other buffers.
  (should-not (eq (lookup-key button-map [mouse-1]) #'my/android-dashboard-push-button))
  (should-not (eq (lookup-key button-map [touchscreen-down])
                  #'my/android-dashboard-push-button))
  (should (equal (lookup-key my/android-dashboard-button-map (kbd "RET"))
                 (lookup-key button-map (kbd "RET"))))
  (with-temp-buffer
    (insert (my/android-dashboard-bookmark-button "test bookmark" 20))
    (should (eq (button-get (button-at (point-min)) 'keymap)
                my/android-dashboard-button-map))))

(ert-deftest android-dashboard-button-command-forwards-translated-event ()
  (let* ((event '(mouse-1 (test-window 42 (10 . 20) 0)))
         (last-command-event event)
         (last-input-event '(touchscreen-end (test-window 1 (10 . 20) 0)))
         received)
    (cl-letf (((symbol-function 'push-button)
               (lambda (position &rest _)
                 (setq received position)
                 'activated)))
      (should (eq (call-interactively #'my/android-dashboard-push-button) 'activated))
      (should (eq received event)))))

(ert-deftest android-dashboard-button-command-preserves-keyboard-activation ()
  (with-temp-buffer
    (insert "button")
    (goto-char 3)
    (let ((last-command-event 13)
          (last-input-event '(touchscreen-end stale-position))
          received)
      (cl-letf (((symbol-function 'push-button)
                 (lambda (position &rest _)
                   (setq received position)
                   t)))
        (should (call-interactively #'my/android-dashboard-push-button))
        (should (= received 3))))))

(ert-deftest android-dashboard-raw-touch-down-delegates-tap-tracking ()
  ;; push-button owns waiting for the matching release; forwarding the raw
  ;; event intact retains its drag/cancellation handling instead of activating
  ;; the stale dashboard point immediately.
  (let* ((event '(touchscreen-down (test-window 42 (10 . 20) 0)))
         (last-command-event event)
         received)
    (cl-letf (((symbol-function 'push-button)
               (lambda (position &rest _) (setq received position) t)))
      (should (call-interactively #'my/android-dashboard-push-button))
      (should (eq received event)))))

(ert-deftest android-dashboard-click-activates-event-button-not-old-point ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert (my/android-dashboard-bookmark-button "first" 20) "\n")
      (let ((second (point))
            activated)
        (insert (my/android-dashboard-bookmark-button "second" 20) "\n")
        (goto-char (point-min))
        (let ((last-command-event
               (list 'mouse-1 (list (selected-window) second '(0 . 0) 0)))
              (last-input-event '(touchscreen-end stale-position)))
          (cl-letf (((symbol-function 'bookmark-jump)
                     (lambda (name) (push name activated))))
            (should (call-interactively #'my/android-dashboard-push-button))
            (should (equal activated '("second")))))))))

(ert-deftest android-dashboard-background-release-opens-keyboard-only-off-buttons ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert (my/android-dashboard-bookmark-button "bookmark" 20) "\n\n")
      (let ((button-event (list 'mouse-1 (list (selected-window) 1 '(0 . 0) 0)))
            (background-event
             (list 'mouse-1 (list (selected-window) (1- (point-max)) '(0 . 0) 0)))
            (keyboard-count 0)
            activated)
        (cl-letf (((symbol-function 'bookmark-jump)
                   (lambda (name) (push name activated)))
                  ((symbol-function 'frame-toggle-on-screen-keyboard)
                   (lambda (frame hide)
                     (should-not frame)
                     (should-not hide)
                     (cl-incf keyboard-count))))
          (my/android-dashboard-background-tap button-event)
          (should (equal activated '("bookmark")))
          (should (= keyboard-count 0))
          (my/android-dashboard-background-tap background-event)
          (should (= keyboard-count 1))
          (should (equal activated '("bookmark"))))))))

(ert-deftest android-dashboard-keyboard-on-release-is-buffer-local ()
  (let ((touch-screen-display-keyboard t)
        (original-require (symbol-function 'require))
        (keyboard-count 0))
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (unless (eq feature 'hide-mode-line)
                   (apply original-require feature args))))
              ((symbol-function 'frame-toggle-on-screen-keyboard)
               (lambda (&rest _) (cl-incf keyboard-count))))
      (with-temp-buffer
        (use-local-map (make-sparse-keymap))
        (my/android-dashboard-quiet-mode)
        (should (local-variable-p 'touch-screen-display-keyboard))
        (should-not touch-screen-display-keyboard)
        (should (eq (lookup-key (current-local-map) [mouse-1])
                    #'my/android-dashboard-background-tap))
        ;; Neither the setup hook nor touch-down requests a keyboard resize.
        (should-not (lookup-key (current-local-map) [down-mouse-1]))
        (should-not (lookup-key (current-local-map) [touchscreen-down]))
        (should (= keyboard-count 0)))
      (with-temp-buffer
        (should touch-screen-display-keyboard)
        (should-not (local-variable-p 'touch-screen-display-keyboard)))
      (should (default-value 'touch-screen-display-keyboard)))))

(ert-deftest android-dashboard-block-prefers-a-distinct-theme-background ()
