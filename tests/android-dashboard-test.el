;;; android-dashboard-test.el --- Android landing-screen regressions -*- lexical-binding: t; -*-
;; Run: emacs --batch -Q -l tests/android-dashboard-test.el
(require 'ert)
(require 'cl-lib)
(require 'bookmark)
(require 'hl-line)
(defvar +dashboard-functions nil)
(defvar +dashboard-name "*doom*")
(defvar +dashboard-anchor nil)
(defvar +dashboard-mode-hook nil)
(defvar +doom-dashboard-mode-hook nil)
(defvar hide-mode-line-mode nil)
(defvar touch-screen-display-keyboard)
(defconst android-dashboard-test-config
  (expand-file-name "../+android-dashboard.el"
                    (file-name-directory (or load-file-name buffer-file-name))))

(let ((system-type 'android)
      (+dashboard-functions nil)
      (+dashboard-mode-hook nil)
      (+doom-dashboard-mode-hook nil))
  (load android-dashboard-test-config nil t))

(ert-deftest android-dashboard-desktop-settings-untouched ()
  (let ((system-type 'darwin)
        (+dashboard-functions '(desktop-widget))
        (+dashboard-anchor '(center . left))
        (+dashboard-mode-hook nil)
        (+doom-dashboard-mode-hook nil))
    (load android-dashboard-test-config nil t)
    (should (equal +dashboard-functions '(desktop-widget)))
    (should (equal +dashboard-anchor '(center . left)))
    (should-not +dashboard-mode-hook)
    (should-not +doom-dashboard-mode-hook)))

(ert-deftest android-dashboard-bookmark-recency-does-not-mutate-records ()
  (let* ((bookmark-alist '(("old" (last-modified . (0 1)))
                           ("new" (last-modified . (0 30)))
                           ("legacy one" (filename . "one"))
                           ("middle" (last-modified . (0 20)))
                           ("legacy two" (filename . "two"))
                           ("last" (filename . "last"))))
         (before (copy-tree bookmark-alist))
         (bookmark-sort-flag t))
    (cl-letf (((symbol-function 'bookmark-maybe-load-default-file) #'ignore))
      (should (equal (my/android-dashboard-recent-bookmarks)
                     '("new" "middle" "old" "legacy one" "legacy two")))
      (should (equal bookmark-alist before))
      (should (eq bookmark-sort-flag t)))))

(ert-deftest android-dashboard-bookmarks-deduplicate-stacked-names ()
  (let ((bookmark-alist '(("same" (last-modified . (0 3)))
                          ("same" (last-modified . (0 2)))
                          ("other" (last-modified . (0 1))))))
    (cl-letf (((symbol-function 'bookmark-maybe-load-default-file) #'ignore))
      (should (equal (my/android-dashboard-recent-bookmarks) '("same" "other"))))))

(ert-deftest android-dashboard-empty-bookmarks-preserve-quiet-wordmark ()
  (let ((bookmark-alist nil)
        (text-scale-mode-amount -1))
    (cl-letf (((symbol-function 'bookmark-maybe-load-default-file) #'ignore))
      (with-temp-buffer
        (my/android-dashboard-wordmark)
        (should (equal (buffer-substring-no-properties (point-min) (point-max))
                       " \nD O O M\nE M A C S\n"))
