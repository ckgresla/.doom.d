(ert-deftest android-dashboard-block-blends-flat-themes-in-light-and-dark ()
  (dolist (dark '(nil t))
    (cl-letf (((symbol-function 'face-background)
               (lambda (&rest _) (if dark "black" "white")))
              ((symbol-function 'face-foreground)
               (lambda (&rest _) (if dark "white" "black")))
              ((symbol-function 'color-name-to-rgb)
               (lambda (color) (if (equal color "black") '(0 0 0) '(1 1 1)))))
      (should (equal (my/android-dashboard-block-background)
                     (if dark "#191919" "#e5e5e5"))))))

(ert-deftest android-dashboard-renders-five-buttons-with-narrow-width ()
  (let ((bookmark-alist '(("one very long bookmark name") ("two") ("three")
                          ("four") ("five") ("six"))))
    (cl-letf (((symbol-function 'bookmark-maybe-load-default-file) #'ignore)
              ((symbol-function 'window-body-width) (lambda (&rest _) 180))
              ((symbol-function 'window-font-width) (lambda (&rest _) 10)))
      (with-temp-buffer
        (my/android-dashboard-bookmarks)
        (let ((position (point-min)) names)
          (while-let ((button (next-button position)))
            (push (button-get button 'my/android-dashboard-bookmark) names)
            ;; Eighteen visible cells, minus the four-cell outer safety margin.
            (should (= (string-width (buffer-substring-no-properties
                                      (button-start button) (button-end button)))
                       14))
            (setq position (button-end button)))
          (should (equal (nreverse names)
                         '("one very long bookmark name" "two" "three" "four" "five"))))))))

(ert-deftest android-dashboard-bookmarks-have-configurable-wordmark-gap ()
  (let ((my/android-dashboard-bookmark-gap 3.0))
